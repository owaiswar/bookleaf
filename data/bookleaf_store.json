    {
      "id": "msg-2",
      "ticketId": "ticket-1",
      "senderId": "admin-1",
      "senderRole": "admin",
      "senderName": "BookLeaf Ops Admin",
      "visibility": "public",
      "body": "Dear Priya,\n\nThank you for reaching out to us. We have verified your royalty records for \"Whispers of the Monsoon\". Your total pending royalty of ₹8,600 comfortably exceeds our ₹1,000 threshold.\n\nUnder BookLeaf policy, royalties are calculated quarterly and disbursed within 45 days of the quarter-end. Your Q3 earnings are currently scheduled for electronic transfer to your linked HDFC account by November 10th, 2024. You will receive an automated transaction UTR reference via SMS as soon as the batch clears.\n\nPlease let us know if you need any additional assistance!\n\nWarm regards,\nBookLeaf Author Support Team",
      "createdAt": "2026-10-25T04:31:55.292Z"
    },
    {
      "id": "msg-3",
      "ticketId": "ticket-3",
      "senderId": "admin-1",
      "senderRole": "admin",
      "senderName": "BookLeaf Ops Admin",
      "visibility": "internal",
      "body": "Internal note: Delhi print shop confirmed defective batch from press #2. Initiated reprint request for 6 replacement copies.",
      "createdAt": "2026-10-23T08:31:55.292Z"
    },
    {
      "id": "msg-4",
      "ticketId": "ticket-3",
      "senderId": "admin-1",
      "senderRole": "admin",
      "senderName": "BookLeaf Ops Admin",
      "visibility": "public",
      "body": "Dear Rohit,\n\nWe sincerely apologize for the inconvenience caused by the print flaw in your author copies. At BookLeaf, we take print standards very seriously.\n\nWe have immediately approved a 100% free reprint of 6 pristine replacement copies from our Delhi printing facility. The reprint order has been expedited (5–7 business days turnaround) and will be dispatched directly to your Bengaluru address with Blue Dart tracking.\n\nThank you for bringing this to our attention.\n\nWarm regards,\nBookLeaf Operations",
      "createdAt": "2026-10-24T20:31:55.292Z"
    },
    {
      "id": "msg-5",
      "ticketId": "ticket-6",
      "senderId": "admin-1",
      "senderRole": "admin",
      "senderName": "BookLeaf Ops Admin",
      "visibility": "public",
      "body": "Dear Meera,\n\nWelcome to BookLeaf Publishing! We are delighted to have you on board.\n\nYou can easily link your bank account by navigating to Author Dashboard > Profile & Settings > Bank Details. Please ensure your account holder name matches your PAN card. Once submitted, our finance desk verifies the penny-drop within 24–48 hours.\n\nBest wishes on your publishing journey!\n\nWarm regards,\nBookLeaf Author Support",
      "createdAt": "2026-10-24T22:31:55.292Z"
    },
    {
      "id": "msg-1792922264289-909",
      "ticketId": "ticket-1792922079418-961",
      "senderId": "admin-1",
      "senderRole": "admin",
      "senderName": "BookLeaf Ops Admin",
      "visibility": "public",
      "body": "Dear owais,\n\nWe sincerely apologize for the quality issue you experienced with your copies of your book. Quality is a cornerstone of our commitment to authors.\n\nFor verified physical printing flaws, binding defects, or page collation issues, BookLeaf provides a 100% free reprint. \n\nTo help our quality assurance desk at our Delhi facility expedite your reprint approval, please reply with or attach clear photographs of the defective pages or binding. Once verified, replacement copies will be dispatched within our standard 5–7 business days print turnaround.\n\nThank you for your patience while we make this right.\n\nWarm regards,\nBookLeaf Quality Assurance Desk",
      "createdAt": "2026-10-25T09:57:44.289Z"
    }
